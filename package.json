{
  "name": "testability",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "test": "playwright test",
    "test:headed": "playwright test --headed --project=chromium",
    "test:ui": "playwright test --ui",
    "test:chromium": "playwright test --project=chromium",
    "test:cucumber": "tsx ./node_modules/@cucumber/cucumber/bin/cucumber.js",
    "report": "playwright show-report",
    "allure:generate": "allure generate allure-results --clean -o allure-report",
    "allure:open": "allure open allure-report",
    "docker:build": "docker compose build",
    "docker:test": "docker compose run --rm tests",
    "docker:test:chromium": "docker compose run --rm tests npx playwright test --project=chromium"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "devDependencies": {
    "@cucumber/cucumber": "^10.9.0",
    "@playwright/test": "^1.62.1",
    "allure-playwright": "^3.10.2",
    "dotenv": "^17.4.2",
    "playwright-bdd": "^9.2.0",
    "ts-node": "^10.9.2",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "fillup-fake-data": "^1.0.1"
  }
}
